# Application Environment
APP_ENV=development
DEBUG=true
PORT=8000
SECRET_KEY=cineverse-super-secret-development-key-change-in-prod

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=movie_booking
