# Application Environment
APP_ENV=development
DEBUG=true
PORT=8000
SECRET_KEY=cineverse-super-secret-development-key-change-in-prod

# Database Configuration (Zero-setup local SQLite or MySQL 8)
# To use the pre-seeded SQLite database immediately:
DATABASE_URL=sqlite:///./cineverse_dev.db

# Or for MySQL 8 (uncomment and configure):
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=cineverse
# DB_PASSWORD=cineverse_secret
# DB_NAME=movie_ticket_booking
# DATABASE_URL=mysql+pymysql://cineverse:cineverse_secret@localhost:3306/movie_ticket_booking

# LLM Configuration (OpenAI-compatible)
# Leave empty for deterministic offline mock mode
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
